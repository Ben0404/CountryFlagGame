<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable outlined/light shape used for secondary controls and text inputs. -->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/card_white" />

    <stroke
        android:width="1.5dp"
        android:color="@color/navy" />

    <corners android:radius="14dp" />

    <padding
        android:left="16dp"
        android:top="10dp"
        android:right="16dp"
        android:bottom="10dp" />

</shape>
