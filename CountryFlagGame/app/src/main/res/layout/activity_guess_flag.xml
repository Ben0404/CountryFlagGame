<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for Guess Flag. Functional controls are connected to Java with findViewById(). -->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/navy">

            <!-- Navigation button used to leave the current screen/game mode. -->
            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="←  Back"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guess the Flag"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <!-- Displays the score for the current round in the header. -->
            <TextView
                android:id="@+id/scoreText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Score: 0"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- GAME CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_background"
                android:elevation="4dp"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find the flag for"
                    android:textSize="15sp"
                    android:textColor="@color/text_grey" />

                <!-- Displays the country name the player must match to one of the flags. -->
                <TextView
                    android:id="@+id/countryNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Country Name"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp" />

                <!-- First clickable flag choice. Clicking it immediately submits position 0. -->
                <ImageButton
                    android:id="@+id/flagButton1"
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/secondary_button"
                    android:contentDescription="Flag option 1"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <!-- Second clickable flag choice. Clicking it immediately submits position 1. -->
                <ImageButton
                    android:id="@+id/flagButton2"
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/secondary_button"
                    android:contentDescription="Flag option 2"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp" />

                <!-- Third clickable flag choice. Clicking it immediately submits position 2. -->
                <ImageButton
                    android:id="@+id/flagButton3"
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/secondary_button"
                    android:contentDescription="Flag option 3"
                    android:padding="8dp" />

                <!-- Displays CORRECT! or WRONG! feedback after checking an answer. -->
                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp" />

                <!-- Hidden during play and shown after a Guess-the-Flag round has finished. -->
                <Button
                    android:id="@+id/nextButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="NEXT"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="@drawable/primary_button"
                    android:backgroundTint="@color/navy"
                    android:visibility="gone"
                    android:layout_marginTop="18dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
